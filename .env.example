# MCP Server Transport Configuration
# Options: 'sse' or 'stdio' (defaults to sse if left empty)
TRANSPORT=sse

# Host to bind to if using sse as the transport (use 0.0.0.0 for Docker)
HOST=0.0.0.0

# Port to listen on if using sse as the transport
PORT=8051

# Ollama Configuration
# Use the actual IP address of your Ollama instance
# For local Docker-to-Docker: http://host.docker.internal:11434
# For remote host: http://192.168.1.10:11434
OLLAMA_BASE_URL=http://192.168.1.10:11434

# Ollama model to use for embeddings
# Options: nomic-embed-text, mxbai-embed-large, all-minilm, etc.
OLLAMA_MODEL=nomic-embed-text

# Model choice for contextual embeddings (leave empty to disable)
# When enabled, generates contextual information for better retrieval
MODEL_CHOICE=nomic-embed-text

# Supabase Configuration
# Get your SUPABASE_URL from the API section of your Supabase project settings -
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=http://192.168.1.10:8000

# Get your SUPABASE_SERVICE_KEY from the API section of your Supabase project settings -
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
# On this page it is called the service_role secret (NOT the anon public key)
SUPABASE_SERVICE_KEY=your_service_role_secret_here

# GitHub Token (optional, for scanning repositories)
# Get from: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=